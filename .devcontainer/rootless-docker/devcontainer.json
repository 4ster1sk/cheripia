{
	"name": "Cheripia (rootless Docker)",
	"dockerComposeFile": "../compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"remoteUser": "root",
	"containerUser": "root",
	"updateRemoteUserUID": false,
	"forwardPorts": [3000],
	"onCreateCommand": "/bin/bash .devcontainer/install-toolchain.sh",
	"postCreateCommand": "/bin/bash .devcontainer/init.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"editorconfig.editorconfig",
				"dbaeumer.vscode-eslint",
				"Vue.volar",
				"mrmlnc.vscode-json5",
				"eamodio.gitlens"
			]
		}
	}
}
